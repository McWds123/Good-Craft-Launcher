<Page x:Class="GCL3.Gui.Pages.AboutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:GCL3.Gui.Pages"
      mc:Ignorable="d"
      Title="AboutPage" Height="450" Width="800">
    <Grid>
        <ContentControl x:Name="MainContent"/>
        <Border DockPanel.Dock="Bottom"
                Background="#F5F5F5"
                BorderBrush="#DDDDDD"
                BorderThickness="0,1,0,0">
            <UniformGrid Rows="1" Height="60" x:Name="GoTab">
                <Button x:Name="HomePageBtn" Content="首页"/>
                <Button x:Name="DownloadPageBtn" Content="下载" />
                <Button x:Name="SettingsPageBtn" Content="设置" />
                <Button x:Name="AboutPageBtn" Content="关于" />
            </UniformGrid>
        </Border>
    </Grid>
</Page>
